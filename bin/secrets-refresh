#!/usr/bin/env bash
# Pull secrets from Bitwarden Secrets Manager into a file that shells source.
# Each secret's name is the env var name; the machine-account token only sees
# one project, so no project id is needed. CLONE_REPOS is excluded (it is read
# directly by setup-interactive.sh). On any failure the previous file is left
# untouched and this exits non-zero. Never prints secret values.
#
# Overrides: BWS_TOKEN_FILE (default ~/.config/bws/token),
#            SECRETS_FILE   (default ~/.config/secrets.env).
set -euo pipefail

token_file="${BWS_TOKEN_FILE:-$HOME/.config/bws/token}"
target="${SECRETS_FILE:-$HOME/.config/secrets.env}"

die() {
  echo "secrets-refresh: $*" >&2
  exit 1
}

[[ -r "$token_file" ]] || die "no token at $token_file"
command -v bws > /dev/null || die "bws not on PATH"
command -v jq > /dev/null || die "jq not on PATH"

json="$(BWS_ACCESS_TOKEN="$(cat "$token_file")" bws secret list --output json)" ||
  die "bws failed; kept the existing secrets file"

bad="$(jq -r '.[].key | select(test("^[A-Za-z_][A-Za-z0-9_]*$") | not)' <<< "$json")" ||
  die "unexpected bws output; kept the existing secrets file"
[[ -z "$bad" ]] || die "not valid env var names: $(tr '\n' ' ' <<< "$bad")- kept the existing secrets file"

umask 077
mkdir -p "$(dirname "$target")"
tmp="$(mktemp "$target.XXXXXX")"
trap 'rm -f "$tmp"' EXIT
jq -r '.[] | select(.key != "CLONE_REPOS") | "export \(.key)=\(.value | @sh)"' <<< "$json" > "$tmp"
chmod 600 "$tmp"
mv -f "$tmp" "$target"
trap - EXIT

echo "secrets-refresh: wrote $(wc -l < "$target") secrets to $target (open a new shell to pick them up)"
