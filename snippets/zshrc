# Interactive zsh: Oh My Zsh for plugins, powerlevel10k for the prompt, then
# history, zoxide, nvm. Every source is guarded so a partial install never
# breaks the shell.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="" # powerlevel10k owns the prompt; an Oh My Zsh theme would fight it
zstyle ':omz:update' mode disabled # install.sh pins the Oh My Zsh commit
plugins=(git sudo extract colored-man-pages docker docker-compose kubectl helm)
if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  source "$ZSH/oh-my-zsh.sh"
fi

# The theme defines the machinery; the config sets the parameters it reads.
# The wizard is off so a missing config file gives a plain prompt, not a
# full-screen setup dialog on every shell start.
typeset -g POWERLEVEL9K_DISABLE_CONFIGURATION_WIZARD=true
if [[ -r "$ZSH/custom/themes/powerlevel10k/powerlevel10k.zsh-theme" ]]; then
  source "$ZSH/custom/themes/powerlevel10k/powerlevel10k.zsh-theme"
  if [[ -r "$HOME/code/utilities/zsh/p10k.zsh" ]]; then
    source "$HOME/code/utilities/zsh/p10k.zsh"
  fi
fi

HISTFILE="${HISTFILE:-$HOME/.zsh_history}"
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE SHARE_HISTORY

if (( $+commands[zoxide] )); then
  eval "$(zoxide init zsh)"
fi

export NVM_DIR="$HOME/.nvm"
if [[ -s "$NVM_DIR/nvm.sh" ]]; then
  source "$NVM_DIR/nvm.sh"
fi
if [[ -s "$NVM_DIR/bash_completion" ]]; then
  source "$NVM_DIR/bash_completion"
fi

# Last: syntax highlighting has to wrap every widget defined above.
if [[ -r /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ]]; then
  source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
fi
if [[ -r /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi
